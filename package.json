{
  "name": "coddy-for-browser",
  "version": "0.1.1",
  "description": "Browser extension (Chrome, Yandex Browser, Firefox) that lets a self-hosted Coddy agent work in the tabs you share with it.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-timeout=30000 tests/*.test.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:firefox": "node tests/e2e/firefox.mjs",
    "icons": "node scripts/render-icons.mjs"
  }
}
